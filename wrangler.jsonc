{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retell",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONTEXT", "class_name": "GenerationContext" },
      { "name": "LIMITER", "class_name": "RateLimiter" }
    ]
  },
  // 线上 retell Worker 由早期原型部署,迁移标签已停在 v3 且只有 SessionDO 一个 DO 类;
  // v3 在此仅作锚点占位,v4 才是真实迁移:创建当前两个 DO 类并删除遗留的 SessionDO。
  // 若换新 Worker 名字全新部署,请把 migrations 重置为单条 new_sqlite_classes 迁移。
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GenerationContext"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v3", "deleted_classes": ["SessionDO"] },
    { "tag": "v4", "new_sqlite_classes": ["GenerationContext", "RateLimiter"], "deleted_classes": ["SessionDO"] }
  ],
  "observability": { "enabled": true },
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash",
    "DAILY_BUDGET": "200"
  }
}
